# Copy to `.env` / Dokploy secrets.

PUBLIC_SITE_URL=https://5svg.com

# MySQL (EditStamp-style)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=5svg

# =============================================================================
# Creem — 命名对齐 EditStamp
# =============================================================================
# CREEM_API_KEY / CREEM_WEBHOOK_SECRET / CREEM_SERVER_IDX(0正式|1测试)
#
# 产品（一次性）：
#   SINGLE — SVG Theme Pack ($4.50)
#   WHOLE  — All SVG Theme Packs ($9.90)
#   CREEM_PRICE_ID_* / PUBLIC_CREEM_PRICE_ID_* / NEXT_PUBLIC_CREEM_PRICE_ID_*
#
# 不要用 PRO_MONTHLY / PRO_YEARLY（订阅，5SVG 暂无）
# 正式 / 测试：同一套变量名，换两套值即可（见下方示例）
# =============================================================================

CREEM_MOCK=1
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_SERVER_IDX=1

CREEM_PRICE_ID_SINGLE=
PUBLIC_CREEM_PRICE_ID_SINGLE=
NEXT_PUBLIC_CREEM_PRICE_ID_SINGLE=

CREEM_PRICE_ID_WHOLE=
PUBLIC_CREEM_PRICE_ID_WHOLE=
NEXT_PUBLIC_CREEM_PRICE_ID_WHOLE=

# --- 测试 sandbox ---
# CREEM_MOCK=0
# CREEM_API_KEY=creem_test_xxx
# CREEM_WEBHOOK_SECRET=whsec_xxx
# CREEM_SERVER_IDX=1
# CREEM_PRICE_ID_SINGLE=prod_theme_pack
# PUBLIC_CREEM_PRICE_ID_SINGLE=prod_theme_pack
# CREEM_PRICE_ID_WHOLE=prod_all_packs
# PUBLIC_CREEM_PRICE_ID_WHOLE=prod_all_packs

# --- 正式 live ---
# CREEM_MOCK=0
# CREEM_API_KEY=creem_xxx
# CREEM_WEBHOOK_SECRET=whsec_xxx
# CREEM_SERVER_IDX=0
# CREEM_PRICE_ID_SINGLE=prod_theme_pack_live
# CREEM_PRICE_ID_WHOLE=prod_all_packs_live

# Resend — required on Dokploy for paid-order backup emails (link only, no ZIP).
# Domain for RESEND_FROM_EMAIL must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=5SVG <support@5svg.com>
