# Copy to `.env` / Dokploy secrets.

PUBLIC_SITE_URL=https://5svg.com

# MySQL (EditStamp-style)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=5svg

# =============================================================================
# Creem — 命名对齐 EditStamp
# =============================================================================
# CREEM_API_KEY / CREEM_WEBHOOK_SECRET / CREEM_SERVER_IDX(0正式|1测试)
#
# 产品：一期仅「单次 Bundle ZIP」→ SINGLE（对应 EditStamp Instant Export）
#   CREEM_PRICE_ID_SINGLE              ← 服务端结账优先读
#   PUBLIC_CREEM_PRICE_ID_SINGLE       ← SvelteKit 公开回退
#   NEXT_PUBLIC_CREEM_PRICE_ID_SINGLE  ← 与 EditStamp 同名，也可填
#
# 不要用 PRO_MONTHLY / PRO_YEARLY（那是订阅，5SVG 暂无）
# 正式 / 测试：同一套变量名，换两套值即可（见下方示例）
# =============================================================================

CREEM_MOCK=1
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_SERVER_IDX=1

CREEM_PRICE_ID_SINGLE=
PUBLIC_CREEM_PRICE_ID_SINGLE=
NEXT_PUBLIC_CREEM_PRICE_ID_SINGLE=

# --- 测试 sandbox ---
# CREEM_MOCK=0
# CREEM_API_KEY=creem_test_xxx
# CREEM_WEBHOOK_SECRET=whsec_xxx
# CREEM_SERVER_IDX=1
# CREEM_PRICE_ID_SINGLE=prod_xxx_test
# PUBLIC_CREEM_PRICE_ID_SINGLE=prod_xxx_test
# NEXT_PUBLIC_CREEM_PRICE_ID_SINGLE=prod_xxx_test

# --- 正式 live ---
# CREEM_MOCK=0
# CREEM_API_KEY=creem_xxx
# CREEM_WEBHOOK_SECRET=whsec_xxx
# CREEM_SERVER_IDX=0
# CREEM_PRICE_ID_SINGLE=prod_xxx_live
# PUBLIC_CREEM_PRICE_ID_SINGLE=prod_xxx_live
# NEXT_PUBLIC_CREEM_PRICE_ID_SINGLE=prod_xxx_live

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=5SVG <support@5svg.com>
